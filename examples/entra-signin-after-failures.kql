// Review candidate: a successful sign-in after repeated failures for one identity.
// User mistakes and approved automation can match; protect query-result access.
// Each qualifying success can produce a row; suppress or deduplicate repeated alerts per identity.
let signins = union kind=outer
  (SigninLogs
   | where TimeGenerated >= ago(30m)
   | project Tenant=tostring(AADTenantId), UserId, UserPrincipalName,
             SigninAt=coalesce(todatetime(CreatedDateTime), TimeGenerated), IPAddress, ResultType),
  (AADNonInteractiveUserSignInLogs
   | where TimeGenerated >= ago(30m)
   | project Tenant=tostring(AADTenantId), UserId, UserPrincipalName,
             SigninAt=coalesce(todatetime(CreatedDateTime), TimeGenerated), IPAddress, ResultType)
| extend User=case(isnotempty(tostring(UserId)), strcat("id:", tolower(tostring(UserId))),
                   isnotempty(tostring(UserPrincipalName)), strcat("upn:", tolower(tostring(UserPrincipalName))), ""),
         ErrorCode=toint(ResultType)
| where isnotempty(Tenant) and isnotempty(User) and isnotnull(SigninAt) and isnotnull(ErrorCode);
let successes = signins
| where ErrorCode == 0
| project Tenant, User, SuccessAt=SigninAt, SuccessIP=IPAddress;
let failures = signins
| where ErrorCode != 0
| project Tenant, User, FailureAt=SigninAt, FailureIP=IPAddress;
successes
| join kind=inner failures on Tenant, User
| where FailureAt >= SuccessAt - 15m and FailureAt < SuccessAt
| summarize Failures=count(), SourceIPs=dcount(FailureIP),
            FirstFailure=min(FailureAt), LastFailure=max(FailureAt)
  by Tenant, User, SuccessAt, SuccessIP
| where Failures >= 5
| project Tenant, User, SuccessAt, SuccessIP, Failures, SourceIPs, FirstFailure, LastFailure
| order by SuccessAt desc
