// Review signal, not proof of compromise or the same token/session.
// Normal integrations may match. Restrict to monitored application IDs if appropriate.
let app_signins = union kind=outer
  (AADServicePrincipalSignInLogs
   | where TimeGenerated >= ago(70m)
   | where ResultType =~ "Success"
   | project Tenant=AADTenantId, AppId, ServicePrincipalId, SignedAt=CreatedDateTime, UniqueTokenIdentifier),
  (AADManagedIdentitySignInLogs
   | where TimeGenerated >= ago(70m)
   | where ResultType =~ "Success"
   | project Tenant=AADTenantId, AppId, ServicePrincipalId, SignedAt=CreatedDateTime, UniqueTokenIdentifier);
MicrosoftGraphActivityLogs
| where TimeGenerated >= ago(10m)
| where ResponseStatusCode between (200 .. 299)
| where isnotempty(AadTenantId) and isnotempty(AppId) and isnotempty(ServicePrincipalId)
| extend Path=tolower(tostring(parse_url(RequestUri).Path))
| extend Category=case(Path matches regex @"/(messages|mailfolders)(/|$)", "mail",
                       Path matches regex @"/(\$batch)(/|$)", "batch",
                       Path matches regex @"/(drives|drive|sites)(/|$)", "files",
                       Path matches regex @"/(rolemanagement|directoryroles|roleassignments)(/|$)", "roles",
                       Path matches regex @"/(oauth2permissiongrants|approleassignments|approleassignedto)(/|$)", "application_permissions",
                       Path matches regex @"/(authenticationmethodspolicies|authenticationmethodspolicy|authenticationmethods)(/|$)", "authentication",
                       Path matches regex @"/(identitygovernance|privilegedaccess)(/|$)", "privileged_access",
                       Path matches regex @"/(devicemanagement|manageddevices|devicecompliancepolicies)(/|$)", "device_management",
                       Path matches regex @"/(security)(/|$)", "security",
                       Path matches regex @"/(enterprise)(/|$)", "agent_mcp",
                       Path matches regex @"/(applications|serviceprincipals)(/|$)", "applications",
                       Path matches regex @"/(users|groups|contacts|orgcontacts|organization|devices|teams|directoryobjects|administrativeunits|domains|subscribedskus)(/|$)", "directory", "")
| where isnotempty(Category)
| project Tenant=AadTenantId, AppId, ServicePrincipalId, GraphAt=TimeGenerated, RequestMethod, Category, OperationId, RequestId, SignInActivityId
| join kind=inner app_signins on Tenant, AppId, ServicePrincipalId
| where GraphAt >= SignedAt and GraphAt <= SignedAt + 1h
| extend Correlation=case(isnotempty(SignInActivityId) and isnotempty(UniqueTokenIdentifier),
                           iff(SignInActivityId == UniqueTokenIdentifier, "token_id", "mismatch"), "time_window")
| where Correlation != "mismatch"
| project Tenant, AppId, ServicePrincipalId, SignedAt, GraphAt, RequestMethod, Category, Correlation, OperationId, RequestId
