// Expected administration also matches. Review the original audit record before response.
AuditLogs
| where TimeGenerated >= ago(15m)
| where Result =~ "success"
| where ActivityDisplayName in~ (
    "Update application – Certificates and secrets management",
    "Update application - Certificates and secrets management",
    "Add service principal credentials",
    "Remove service principal credentials",
    "Add application", "Delete application", "Hard Delete application",
    "Add service principal", "Remove service principal", "Hard delete service principal",
    "Add owner to application", "Remove owner from application",
    "Add owner to service principal", "Remove owner from service principal",
    "Add policy to application", "Remove policy from application",
    "Add policy to service principal", "Remove policy from service principal",
    "Add member to role", "Remove member from role",
    "Add eligible member to role", "Remove eligible member from role",
    "Add scoped member to role", "Remove scoped member from role",
    "Remove member from role scoped over Restricted Management Administrative Unit",
    "Remove role assignment from role definition",
    "Disable account", "Enable account",
    "Reset password", "Reset password (by admin)", "Reset password (self-service)",
    "Change password (self-service)",
    "Create application password for user", "Delete application password for user",
    "Update StsRefreshTokenValidFrom Timestamp",
    "Add Passkey (device-bound)", "Delete Passkey (device-bound)",
    "Add Windows Hello for Business credential", "Delete Windows Hello for Business credential",
    "Add passwordless phone sign-in credential", "Delete passwordless phone sign-in credential",
    "Add platform credential", "Delete platform credential",
    "Add Conditional Access policy", "Update Conditional Access policy", "Delete Conditional Access policy",
    "Update security defaults", "Update Sign-In Risk Policy",
    "Update User Risk and MFA Registration Policy",
    "Add bypass user", "Remove bypassed user",
    "Add app role assignment to service principal",
    "Remove app role assignment from service principal",
    "Add delegated permission grant", "Remove delegated permission grant",
    "Consent to application")
| project TimeGenerated, AADTenantId, ActivityDisplayName, Id, InitiatedBy, TargetResources
