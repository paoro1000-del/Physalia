// Export the result as CSV for the local GUI. Shorten the time range if it exceeds
// 10,000 records or 4 MiB; analyze each interval separately, including boundaries.
// Export only Graph request paths, not URI hosts, query strings or fragments; paths may still contain sensitive identifiers.
union kind=outer
  (SigninLogs
   | where TimeGenerated >= ago(1h)
   | extend AgentText=trim(@"\s+", tostring(Agent))
   | extend AgentPresent=isnotempty(AgentText) and AgentText !in ("{}", "[]", "null", "false", "\"\"")
   | project Type="SigninLogs", AADTenantId=tostring(AADTenantId), TimeGenerated, CreatedDateTime, Id,
             IPAddress, UserPrincipalName, UserId, Agent=AgentPresent, ResultType),
  (AADNonInteractiveUserSignInLogs
   | where TimeGenerated >= ago(1h)
   | extend AgentText=trim(@"\s+", tostring(Agent))
   | extend AgentPresent=isnotempty(AgentText) and AgentText !in ("{}", "[]", "null", "false", "\"\"")
   | project Type="AADNonInteractiveUserSignInLogs", AADTenantId=tostring(AADTenantId), TimeGenerated, CreatedDateTime, Id,
             IPAddress, UserPrincipalName, UserId, AppId, Agent=AgentPresent, ResultType),
  (AADServicePrincipalSignInLogs
   | where TimeGenerated >= ago(1h)
   | extend AgentText=trim(@"\s+", tostring(Agent))
   | extend AgentPresent=isnotempty(AgentText) and AgentText !in ("{}", "[]", "null", "false", "\"\"")
   | project Type="AADServicePrincipalSignInLogs", AADTenantId=tostring(AADTenantId), TimeGenerated,
             CreatedDateTime, Id, AppId, ServicePrincipalId, Agent=AgentPresent, ResultType, UniqueTokenIdentifier),
  (AADManagedIdentitySignInLogs
   | where TimeGenerated >= ago(1h)
   | extend AgentText=trim(@"\s+", tostring(Agent))
   | extend AgentPresent=isnotempty(AgentText) and AgentText !in ("{}", "[]", "null", "false", "\"\"")
   | project Type="AADManagedIdentitySignInLogs", AADTenantId=tostring(AADTenantId), TimeGenerated,
             CreatedDateTime, Id, AppId, ServicePrincipalId, Agent=AgentPresent, ResultType, UniqueTokenIdentifier),
  (AuditLogs
   | where TimeGenerated >= ago(1h)
   | project Type="AuditLogs", AADTenantId=tostring(AADTenantId), TimeGenerated,
             ActivityDateTime, ActivityDisplayName, Result),
  (MicrosoftGraphActivityLogs
   | where TimeGenerated >= ago(1h)
   | extend RequestPath=tostring(parse_url(RequestUri).Path)
   | project Type="MicrosoftGraphActivityLogs", AADTenantId=tostring(AadTenantId), TimeGenerated,
             AppId, ServicePrincipalId, RequestMethod,
             RequestUri=iff(isempty(RequestPath), "", strcat("/", replace_regex(RequestPath, @'^/+', ""))),
             ResponseStatusCode, OperationId, RequestId, SignInActivityId)
| order by TimeGenerated asc
